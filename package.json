{
    "name": "requirements-backend",
    "version": "0.0.1",
    "description": "The backend for the requirements app.",
    "author": "Florian Weidinger",
    "license": "MIT",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" --no-error-on-unmatched-pattern",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "migration:generate": "NODE_OPTIONS='-r tsconfig-paths/register' typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
        "migration:run": "NODE_OPTIONS='-r tsconfig-paths/register' typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
        "migration:revert": "NODE_OPTIONS='-r tsconfig-paths/register' typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
        "migration:show": "NODE_OPTIONS='-r tsconfig-paths/register' typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "test:unit": "vitest",
        "test:unit:coverage": "vitest run --coverage",
        "test:e2e": "playwright test --config playwright.config.mts",
        "test:e2e:report": "playwright show-report"
    },
    "dependencies": {
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.0.1",
        "@nestjs/platform-express": "^11.0.1",
        "@nestjs/typeorm": "^11.0.1",
        "pg": "^8.21.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "typeorm": "^1.0.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@playwright/test": "^1.60.0",
        "@swc/core": "^1.15.40",
        "@types/express": "^5.0.0",
        "@types/node": "^24.0.0",
        "@vitest/coverage-istanbul": "^4.1.8",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^17.0.0",
        "prettier": "^3.4.2",
        "source-map-support": "^0.5.21",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0",
        "unplugin-swc": "^1.5.9",
        "vitest": "^4.1.8"
    }
}
